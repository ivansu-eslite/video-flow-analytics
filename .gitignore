# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Model Weights
*.pt

# 雲端 GCS bucket 的本機鏡像（含影片與 camera_registry.yaml，皆由雲端輸出，不進版控）
bucket_name*/

# 分析輸出（標註影片與追蹤結果）；不帶尾斜線，讓 outputs 為 symlink 到外部碟時也擋得住
outputs

# zone 判定視覺化外掛（開發用測試工具，零侵入、上傳前刪資料夾即無痕）
overlay/

# 影片檔案
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv